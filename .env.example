# Service names are resolvable because the worker joins the temporal-network and
# elk_elk Docker networks (see docker-compose.yml). For a stack outside Docker,
# use a reachable host/IP instead.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vseca-elastic-ops
ELASTIC_URL=http://elasticsearch:9200
# Cluster has no security enabled; leave API key unset.
# ELASTIC_API_KEY=
# Alternative: ELASTIC_USERNAME=elastic and ELASTIC_PASSWORD=...
ELASTIC_VERIFY_TLS=false
ELASTIC_CA_CERT=
ELASTIC_CONFIG=./elastic-files.yaml
MAX_PARALLEL_REINDEXES=3
POLL_SECONDS=5
SCHEDULE_ID=vseca-elastic-6h
SCHEDULE_CRON=0 */6 * * *
SCHEDULE_TIMEZONE=UTC
